# /etc/cron.d/kandes-db-backup
# D74-B: daily database backup → rclone → Google Drive
#
# Runs at 03:30 UTC every day (1.5 hours after the Next.js db-backup cron
# so they don't collide).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

30 3 * * * root bash /opt/kandes/scripts/backup-db-rclone.sh >> /var/log/kandes-db-backup.log 2>&1